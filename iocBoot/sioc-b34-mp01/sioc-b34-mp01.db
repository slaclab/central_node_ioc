#================================================================================#
# LCLS MPS PV template for Central Node Application - 1 per application          #
# Macro description:                                                             #
#   - P          : MPLN Prefix                                                   #
#   - APP        : MPS APP ID                                                    #
#   - ID         : ID number in sqlite db                                        #
#   - TYPE       : App card type                                                 #
#   - LOCA       : link node crate location                                      #
#================================================================================#
record(bi, "MPLN:B34:MP11:1:DIG_ONLINE") {
  field(DESC, "RTM Digital [B34-SP08-RTM AID998]")
  field(DTYP, "asynUInt32Digital")
  field(SCAN, "1 second")
  field(ZNAM, "OFFLINE")
  field(ONAM, "ONLINE")
  field(ZSV, "MAJOR")
  field(OSV, "NO_ALARM")
  field(INP, "@asynMask(CENTRAL_NODE 45 1 0)MPS_APP_STATUS")
}
record(bo, "MPLN:B34:MP11:1:DIG_ENABLE") {
  field(DESC, "Timeout enable bit for app 998")
  field(DTYP, "asynUInt32Digital")
  field(SCAN, "Passive")
  field(ZNAM, "Disable")
  field(ONAM, "Enable")
  field(OMSL, "closed_loop")
  field(OUT, "@asynMask(CENTRAL_NODE 45 1 0)MPS_APP_TIMEOUT_ENABLE")
}
record(bi, "MPLN:B34:MP11:1:DIG_ENABLE_RBV") {
  field(DESC, "Timeout enable bit for app 998")
  field(DTYP, "asynUInt32Digital")
  field(SCAN, "1 second")
  field(ZNAM, "Disabled")
  field(ONAM, "Enabled")
  field(ZSV, "MINOR")
  field(OSV, "NO_ALARM")
  field(INP, "@asynMask(CENTRAL_NODE 45 1 0)MPS_APP_TIMEOUT_ENABLE")
}
#================================================================================#
# LCLS MPS PV template for Central Node DIGITAL bypass                           #
# Macro description:                                                             #
#   - DEVICE_BYP : Device Input PV Prefix                                        #
#   - ONAM       : OK state name                                                 #
#   - ZNAM       : Fault state name.                                             #
#   - LOCA       : Card location                                                 #
#   - CH         : Channel Number                                                #
#   - ID         : Device ID in DB                                               #
#   - ZSV        : Zero Severity                                                 #
#   - OSV        : One Severity                                                  #
#   - INT        : Integrator (digital = 1)                                      #
#   - TYPE       : DIGITAL or ANALOG of FAULT                                    #
#================================================================================#
record(bo, "MPS:B34:1:TEST_DI0_SCBYPV") {
  field(DESC, "B34-SP08-RTM CH 0 Bypass Value")
  field(DTYP, "asynUInt32Digital")
  field(ZNAM, "IS_FAULTED")
  field(ONAM, "IS_OK")
  field(ZSV,  "NO_ALARM")
  field(OSV,  "NO_ALARM")
  field(PINI, "YES")
  field(OUT, "@asynMask(CENTRAL_NODE 226 1 1)MPS_DIGITAL_CHANNEL_BYPV")
}
record(bi, "MPS:B34:1:TEST_DI0_SCBYPV_RBV") {
  field(DESC, "B34-SP08-RTM CH 0 Bypass Value")
  field(DTYP, "asynUInt32Digital")
  field(ZNAM, "IS_FAULTED")
  field(ONAM, "IS_OK")
  field(ZSV,  "NO_ALARM")
  field(OSV,  "NO_ALARM")
  field(PINI, "YES")
  field(INP,  "@asynMask(CENTRAL_NODE 226 1 1)MPS_DIGITAL_CHANNEL_BYPV")
  field(SCAN, "1 second")
}
record(bi, "MPS:B34:1:TEST_DI0_SCBYPS") {
  field(DESC, "B34-SP08-RTM CH 0 Bypass Status")
  field(SCAN, "1 second")
  field(DTYP, "asynUInt32Digital")
  field(ZNAM, "Not Bypassed")
  field(ONAM, "Bypassed")
  field(ZSV, "NO_ALARM")
  field(OSV, "MAJOR")
  field(INP, "@asynMask(CENTRAL_NODE 226 1 1)MPS_DIGITAL_CHANNEL_BYPS")
}
record(longout, "MPS:B34:1:TEST_DI0_SCBYPD") {
  field(DESC, "Bypass duration in seconds")
  field(DTYP, "asynInt32")
  field(EGU, "Seconds")
  field(VAL, "0")
  field(PINI, "YES")
  field(OUT, "@asyn(CENTRAL_NODE 226 1)MPS_DIGITAL_CHANNEL_BYPEXPDATE")
  field(ASG,  "$(ASG2)")
}
record(longin, "MPS:B34:1:TEST_DI0_SCBYPT") {
  field(DESC, "Remaining bypass duration in seconds")
  field(DTYP, "asynInt32")
  field(EGU, "Seconds")
  field(SCAN, "1 second")
  field(VAL, "0")
  field(PINI, "YES")
  field(INP, "@asyn(CENTRAL_NODE 226 1)MPS_DIGITAL_CHANNEL_REMAINING_BYPTIME")
}
record(stringin, "MPS:B34:1:TEST_DI0_SCBYP_END") {
  field(DESC, "Bypass Expiration Date/Time String")
  field(DTYP, "asynOctetRead")
  field(SCAN, "1 second")
  field(VAL, "Invalid")
  field(PINI, "YES")
  field(INP, "@asyn(CENTRAL_NODE 226 1)MPS_DIGITAL_CHANNEL_BYPEXPDATE_STRING")
}
