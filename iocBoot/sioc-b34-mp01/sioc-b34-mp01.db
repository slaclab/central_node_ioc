record(bo, "MPS:B34:1:TEST_DI0_SCBYPV") {
  field(DESC, "B34-SP08-RTM CH 0 Bypass Value")
  field(DTYP, "asynUInt32Digital")
  field(ZNAM, "IS_FAULTED")
  field(ONAM, "IS_OK")
  field(ZSV,  "MAJOR")
  field(OSV,  "NO_ALARM")
  field(PINI, "YES")
  field(OUT, "@asynMask(CENTRAL_NODE 1 1 1)MPS_DIGITAL_CHANNEL_BYPV")
}
record(bi, "MPS:B34:1:TEST_DI0_SCBYPS") {
  field(DESC, "B34-SP08-RTM CH 0 Bypass Status")
  field(SCAN, "1 second")
  field(DTYP, "asynUInt32Digital")
  field(ZNAM, "Not Bypassed")
  field(ONAM, "Bypassed")
  field(ZSV, "NO_ALARM")
  field(OSV, "MAJOR")
  field(INP, "@asynMask(CENTRAL_NODE 1 1 1)MPS_DIGITAL_CHANNEL_BYPS")
}
