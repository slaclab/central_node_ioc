#================================================================================#
# LCLS MPS PV template for Central Node Application - 1 per application          #
# Macro description:                                                             #
#   - P          : MPLN Prefix                                                   #
#   - APP        : MPS APP ID                                                    #
#   - TYPE       : App card type                                                 #
#   - LOCA       : link node crate location                                      #
#================================================================================#
record(bi, "MPLN:B34:MP11:1:DIG_ONLINE") {
  field(DESC, "RTM Digital [B34-SP08-RTM AID1]")
  field(DTYP, "asynUInt32Digital")
  field(SCAN, "1 second")
  field(ZNAM, "OFFLINE")
  field(ONAM, "ONLINE")
  field(ZSV, "MAJOR")
  field(OSV, "NO_ALARM")
  field(INP, "@asynMask(CENTRAL_NODE 1 1 0)MPS_APP_STATUS")
}
record(bo, "MPLN:B34:MP11:1:DIG_ENABLE") {
  field(DESC, "Timeout enable bit for app 1")
  field(DTYP, "asynUInt32Digital")
  field(SCAN, "Passive")
  field(ZNAM, "Disable")
  field(ONAM, "Enable")
  field(OMSL, "closed_loop")
  field(OUT, "@asynMask(CENTRAL_NODE 1 1 0)MPS_APP_TIMEOUT_ENABLE")
}
record(bi, "MPLN:B34:MP11:1:DIG_ENABLE_RBV") {
  field(DESC, "Timeout enable bit for app 1")
  field(DTYP, "asynUInt32Digital")
  field(SCAN, "1 second")
  field(ZNAM, "Disabled")
  field(ONAM, "Enabled")
  field(ZSV, "MINOR")
  field(OSV, "NO_ALARM")
  field(INP, "@asynMask(CENTRAL_NODE 1 1 0)MPS_APP_TIMEOUT_ENABLE")
}
#================================================================================#
# LCLS MPS PV template for Central Node DIGITAL Channel                          #
# Macro description:                                                             #
#   - P          : Device Input PV Prefix                                        #
#   - ONAM       : OK state name                                                 #
#   - ZNAM       : Fault state name.                                             #
#   - LOCA       : Card location                                                 #
#   - CH         : Channel Number                                                #
#   - ID         : Device ID in DB                                               #
#   - ZSV        : Zero Severity                                                 #
#   - OSV        : One Severity                                                  #
#   - MASK       : Bit mask of the channel (digital = 1, analog is thr mask)     #
#   - TYPE       : DIGITAL or ANALOG                                             #
#================================================================================#
record(bi, "MPS:B34:1:TEST_DI0_SCMPSC") {
  field(DESC, "B34-SP08-RTM CH 0")
  field(DTYP, "asynUInt32Digital")
  field(SCAN, "1 second")
  field(ZNAM, "IS_FAULTED")
  field(ONAM, "IS_OK")
  field(ZSV, "MAJOR")
  field(OSV, "NO_ALARM")
  field(INP, "@asynMask(CENTRAL_NODE 1 1 0)MPS_DIGITAL_CHANNEL")
}
record(bi, "MPS:B34:1:TEST_DI0_SCMPS") {
  field(DESC, "B34-SP08-RTM CH 0 Latched Value")
  field(DTYP, "asynUInt32Digital")
  field(SCAN, "1 second")
  field(ZNAM, "IS_FAULTED")
  field(ONAM, "IS_OK")
  field(ZSV, "MAJOR")
  field(OSV, "NO_ALARM")
  field(INP, "@asynMask(CENTRAL_NODE 1 1 0)MPS_DIGITAL_CHANNEL_LATCHED")
}
record(bo, "MPS:B34:1:TEST_DI0_SCUNLH") {
  field(DESC, "B34-SP08-RTM CH 0 Unlatch")
  field(DTYP, "asynUInt32Digital")
  field(OUT, "@asynMask(CENTRAL_NODE 1 1 0)MPS_DIGITAL_CHANNEL_UNLATCH")
  field(ASG,  "$(ASG1)")
}
