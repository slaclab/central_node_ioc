  field(DTYP, "asynInt32")
  field(SCAN, "1 second")
  field(INP,  "@asynMask(CENTRAL_NODE 204 0)MPS_FAULT")
}
record(bi, "SIOC:B34:MP11:STATUS_FLT_IGNORED") {
  field(DESC, "Test Epics Anal Ignored")
  field(DTYP, "asynUInt32Digital")
  field(SCAN, "1 second")
  field(ZNAM, "Not Ignored")
  field(ONAM, "Ignored")
  field(INP,  "@asynMask(CENTRAL_NODE 204 1 0)MPS_FAULT_IGNORED")
}
record(bi, "SIOC:B34:MP11:STATUS_FLT_SCMPS") {
  field(DESC, "Test Epics Anal Faulted")
  field(DTYP, "asynUInt32Digital")
  field(SCAN, "1 second")
  field(ZNAM, "Not Faulted")
  field(ONAM, "Faulted")
  field(INP,  "@asynMask(CENTRAL_NODE 204 1 0)MPS_FAULT_FAULTED")
}
record(bi, "SIOC:B34:MP11:STATUS_FLT_ACTIVE") {
  field(DESC, "Test Epics Anal Active")
  field(DTYP, "asynUInt32Digital")
  field(SCAN, "1 second")
  field(ZNAM, "Not Active")
  field(ONAM, "Active")
  field(INP,  "@asynMask(CENTRAL_NODE 204 1 0)MPS_FAULT_ACTIVE")
}
record(bi, "SIOC:B34:MP11:STATUS_FLT_SCBYPS") {
  field(DESC, "Bypass Status")
  field(SCAN, "1 second")
  field(DTYP, "asynUInt32Digital")
  field(ZNAM, "Not Bypassed")
  field(ONAM, "Bypassed")
  field(ZSV, "NO_ALARM")
  field(OSV, "MAJOR")
  field(INP, "@asynMask(CENTRAL_NODE 204 1 1)MPS_FAULT_BYPS")
}
record(longout, "SIOC:B34:MP11:STATUS_FLT_SCBYPD") {
  field(DESC, "Bypass duration in seconds")
  field(DTYP, "asynInt32")
  field(EGU, "Seconds")
  field(VAL, "0")
  field(PINI, "YES")
  field(OUT, "@asyn(CENTRAL_NODE 204 1)MPS_FAULT_BYPEXPDATE")
  field(ASG,  "$(ASG2)")
}
record(longin, "SIOC:B34:MP11:STATUS_FLT_SCBYPT") {
  field(DESC, "Remaining bypass duration in seconds")
  field(DTYP, "asynInt32")
  field(EGU, "Seconds")
  field(SCAN, "1 second")
  field(VAL, "0")
  field(PINI, "YES")
  field(INP, "@asyn(CENTRAL_NODE 204 1)MPS_FAULT_REMAINING_BYPTIME")
}
record(stringin, "SIOC:B34:MP11:STATUS_FLT_SCBYP_END") {
  field(DESC, "Bypass Expiration Date/Time String")
  field(DTYP, "asynOctetRead")
  field(SCAN, "1 second")
  field(VAL, "Invalid")
  field(PINI, "YES")
  field(INP, "@asyn(CENTRAL_NODE 204 1)MPS_FAULT_BYPEXPDATE_STRING")
}
#================================================================================#
# LCLS MPS PV template for Central Node Faults                                   #
# Macro description:                                                             #
#   - PV         : Device Input PV Prefix                                        #
#   - ID         : Fault  ID                                                     #
#   - DESC       : Fault Description                                             #
#================================================================================#
record(mbbo, "SIOC:B34:MP11:STATUS_FLT_SCBYPV") {
  field(DESC, "Test Epics Anal")
  field(DTYP, "asynInt32")
  field(OUT,  "@asyn(CENTRAL_NODE 204 1)MPS_FAULT_BYPV")
  field(PINI, "YES")
  field(VAL,  "0")
  field(ZRST, "Is Faulted")
  field(ZRVL,  "621")
  field(ZRSV, "NO_ALARM")
  field(ONST, "Is Ok")
  field(ONVL,  "622")
  field(ONSV, "NO_ALARM")
}
#================================================================================#
# LCLS MPS PV template for Central Node Faults                                   #
# Macro description:                                                             #
#   - PV         : Device Input PV Prefix                                        #
#   - ID         : Fault  ID                                                     #
#   - DESC       : Fault Description                                             #
#================================================================================#
record(mbbi, "SIOC:B34:MP11:STATUS_FLT_SCBYPV_RBV") {
  field(DESC, "Test Epics Anal")
  field(DTYP, "asynInt32")
  field(INP,  "@asyn(CENTRAL_NODE 204 1)MPS_FAULT_BYPV")
  field(PINI, "YES")
  field(VAL,  "0")
  field(SCAN, "1 second")
  field(ZRST, "Is Faulted")
  field(ZRVL,  "621")
  field(ZRSV, "NO_ALARM")
  field(ONST, "Is Ok")
  field(ONVL,  "622")
  field(ONSV, "NO_ALARM")
}
