  field(INP, "@asyn(CENTRAL_NODE 1 1)MPS_DIGITAL_CHANNEL_REMAINING_BYPTIME")
}
record(stringin, "MPS:B34:1:TEST_DI0_SCBYP_END") {
  field(DESC, "Bypass Expiration Date/Time String")
  field(DTYP, "asynOctetRead")
  field(SCAN, "1 second")
  field(VAL, "Invalid")
  field(PINI, "YES")
  field(INP, "@asyn(CENTRAL_NODE 1 1)MPS_DIGITAL_CHANNEL_BYPEXPDATE_STRING")
}
